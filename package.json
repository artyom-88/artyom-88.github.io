{
  "name": "artem-ganev-site",
  "version": "2.0.0",
  "private": true,
  "author": "Artem Ganev",
  "license": "GPL-3.0",
  "homepage": "https://artyom-88.github.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/artyom-88/artyom-88.github.io"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "vite build",
    "build:ci": "tsc && pnpm build",
    "build:debug": "vite build --debug",
    "build:dev": "vite build --mode development",
    "compromised:check": "node scripts/check-compromised.js compromised.txt",
    "compromised:update": "node scripts/update-compromised.js compromised.txt",
    "depcheck": "knip",
    "deploy:local": "pnpm build:ci && echo $(git rev-parse HEAD)  > ./dist/version && pnpm gh-pages -d dist -u \"Artёm <artem_ganev@epam.com>\" -m \"Manual deploy\"",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "pre-commit": "node scripts/pre-commit.js",
    "predeploy": "pnpm build",
    "preinstall": "npx --yes only-allow@1.2.2 pnpm && pnpm compromised:update && pnpm compromised:check",
    "prepare": "husky",
    "preview": "vite preview",
    "start": "vite",
    "start:debug": "vite --debug",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:ui": "vitest --ui",
    "test:watch": "vitest watch",
    "update": "ncu -i"
  },
  "dependencies": {
    "@ant-design/icons": "6.1.0",
    "@stackoverflow/stacks-icons": "2.27.0",
    "@tanstack/react-query": "5.95.2",
    "antd": "6.3.3",
    "dayjs": "1.11.20",
    "ky": "1.14.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "7.13.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.2.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.17.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-basic-ssl": "2.2.0",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.1",
    "@vitest/ui": "4.1.1",
    "autoprefixer": "10.4.27",
    "dotenv": "17.3.1",
    "gh-pages": "6.3.0",
    "husky": "9.1.7",
    "jsdom": "29.0.1",
    "knip": "6.0.3",
    "lint-staged": "16.4.0",
    "npm-check-updates": "18.3.0",
    "postcss": "8.5.8",
    "sass": "1.98.0",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.2",
    "vite": "8.0.2",
    "vitest": "4.1.1"
  },
  "pnpm": {
    "overrides": {
      "@babel/runtime": "7.28.2",
      "flatted": "3.4.2",
      "react": "$react",
      "react-dom": "$react-dom",
      "vite": "$vite"
    }
  },
  "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
