{
  "name": "artem-ganev-site",
  "version": "2.0.0",
  "private": true,
  "author": "Artem Ganev",
  "license": "GPL-3.0",
  "homepage": "https://artyom-88.github.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/artyom-88/artyom-88.github.io"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "analyze": "pnpm run build --mode analyze",
    "build": "vite build",
    "build:ci": "tsc && pnpm build",
    "build:debug": "vite build --debug",
    "build:dev": "vite build --mode development",
    "compromised:check": "node scripts/check-compromised.js compromised.txt",
    "compromised:update": "node scripts/update-compromised.js compromised.txt",
    "depcheck": "knip",
    "deploy:local": "pnpm build:ci && echo $(git rev-parse HEAD)  > ./dist/version && pnpm gh-pages -d dist -u \"Artёm <artem_ganev@epam.com>\" -m \"Manual deploy\"",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "pre-commit": "pnpm compromised:check && tsc && lint-staged",
    "predeploy": "pnpm build",
    "preinstall": "npx --yes only-allow@1.2.2 pnpm && pnpm run compromised:update && pnpm run compromised:check",
    "prepare": "husky",
    "preview": "vite preview",
    "start": "vite",
    "start:debug": "vite --debug",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:ui": "vitest --ui",
    "test:watch": "vitest watch",
    "update": "npm-check -u -E -s"
  },
  "dependencies": {
    "@ant-design/icons": "5.5.1",
    "@stackoverflow/stacks-icons": "2.27.0",
    "@tanstack/react-query": "5.95.1",
    "antd": "5.22.1",
    "dayjs": "1.11.20",
    "ky": "1.14.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.2.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.13.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-basic-ssl": "1.2.0",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "3.2.4",
    "autoprefixer": "10.4.27",
    "dotenv": "16.4.5",
    "gh-pages": "6.3.0",
    "husky": "9.1.7",
    "jsdom": "26.1.0",
    "knip": "5.63.1",
    "lint-staged": "16.4.0",
    "npm-check": "6.0.1",
    "postcss": "8.5.8",
    "rollup-plugin-visualizer": "5.12.0",
    "sass": "1.98.0",
    "tailwindcss": "4.2.2",
    "typescript": "5.9.3",
    "vite": "7.1.4",
    "vite-plugin-svgo": "2.0.0",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "overrides": {
      "@babel/runtime": ">=7.26.10",
      "react": "$react",
      "react-dom": "$react-dom",
      "vite": "$vite"
    }
  },
  "lint-staged": {
    "*": [
      "biome check --write"
    ]
  }
}
